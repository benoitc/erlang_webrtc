{erl_opts, [
    debug_info,
    warn_export_vars,
    warn_shadow_vars,
    warn_obsolete_guard,
    warn_unused_import,
    warnings_as_errors
]}.

{minimum_otp_vsn, "29"}.

%% No runtime dependencies beyond OTP (kernel, stdlib, crypto, public_key).
{deps, []}.

{profiles, [
    {test, [
        {deps, [{proper, "1.4.0"}]},
        {erl_opts, [debug_info, nowarn_export_all, {i, "test/support"}]},
        {extra_src_dirs, [{"test", [{recursive, false}]}, {"test/support", [{recursive, false}]}, {"bench", [{recursive, false}]}]}
    ]}
]}.

{project_plugins, [
    {rebar3_proper, "~> 0.12"},
    {erlfmt, "~> 1.7"},
    {rebar3_ex_doc, "~> 0.2"}
]}.

%% API docs (rebar3 ex_doc): the public API is the webrtc module and the
%% webrtc_media_codec behaviour; every other module is internal.
{ex_doc, [
    {source_url, <<"https://github.com/benoitc/erlang_webrtc">>},
    {main, <<"readme">>},
    {extras, [
        <<"README.md">>,
        <<"docs/CONCEPTS.md">>,
        <<"docs/guides/data-channels.md">>,
        <<"docs/guides/send-media.md">>,
        <<"docs/guides/forward-media.md">>,
        <<"docs/guides/frames-and-codec-plugins.md">>,
        <<"docs/guides/statistics.md">>,
        <<"docs/guides/bandwidth-and-qos.md">>,
        <<"docs/REFERENCE.md">>,
        <<"docs/ARCHITECTURE.md">>,
        <<"docs/DEVELOPER_GUIDE.md">>,
        <<"docs/TESTING.md">>,
        <<"docs/PERFORMANCE.md">>,
        <<"docs/INTEROP.md">>,
        <<"interop/PROTOCOL.md">>,
        <<"docs/COMPLIANCE.md">>,
        <<"docs/compliance/datachannel.md">>,
        <<"docs/compliance/dtls.md">>,
        <<"docs/compliance/ice.md">>,
        <<"docs/compliance/rtp.md">>,
        <<"docs/compliance/sctp.md">>,
        <<"docs/compliance/sdp.md">>,
        <<"docs/compliance/security.md">>,
        <<"docs/compliance/srtp.md">>,
        <<"docs/compliance/stats.md">>,
        <<"docs/compliance/stun.md">>,
        <<"docs/compliance/transport.md">>,
        <<"docs/compliance/turn.md">>,
        <<"docs/adr/0001-dtls-in-erlang.md">>,
        <<"docs/adr/0002-sans-io-engines.md">>,
        <<"docs/adr/0003-transport-per-bundle-group.md">>,
        <<"docs/adr/0004-no-media-coding.md">>,
        <<"docs/adr/0005-per-peer-supervision.md">>,
        <<"docs/adr/0006-redacted-logging.md">>,
        <<"CONTRIBUTING.md">>,
        <<"SECURITY.md">>,
        <<"CHANGELOG.md">>,
        <<"LICENSE">>
    ]},
    {groups_for_extras, [
        {<<"Guides">>, [<<"docs/guides/data-channels.md">>, <<"docs/guides/send-media.md">>, <<"docs/guides/forward-media.md">>, <<"docs/guides/frames-and-codec-plugins.md">>, <<"docs/guides/statistics.md">>, <<"docs/guides/bandwidth-and-qos.md">>]},
        {<<"Reference">>, [<<"docs/REFERENCE.md">>, <<"docs/CONCEPTS.md">>]},
        {<<"Change the code">>, [<<"docs/ARCHITECTURE.md">>, <<"docs/DEVELOPER_GUIDE.md">>, <<"docs/TESTING.md">>,
                                 <<"docs/PERFORMANCE.md">>, <<"docs/INTEROP.md">>, <<"interop/PROTOCOL.md">>,
                                 <<"CONTRIBUTING.md">>]},
        {<<"Compliance">>, [<<"docs/COMPLIANCE.md">>, <<"docs/compliance/datachannel.md">>, <<"docs/compliance/dtls.md">>, <<"docs/compliance/ice.md">>, <<"docs/compliance/rtp.md">>, <<"docs/compliance/sctp.md">>, <<"docs/compliance/sdp.md">>, <<"docs/compliance/security.md">>, <<"docs/compliance/srtp.md">>, <<"docs/compliance/stats.md">>, <<"docs/compliance/stun.md">>, <<"docs/compliance/transport.md">>, <<"docs/compliance/turn.md">>]},
        {<<"Design decisions">>, [<<"docs/adr/0001-dtls-in-erlang.md">>, <<"docs/adr/0002-sans-io-engines.md">>, <<"docs/adr/0003-transport-per-bundle-group.md">>, <<"docs/adr/0004-no-media-coding.md">>, <<"docs/adr/0005-per-peer-supervision.md">>, <<"docs/adr/0006-redacted-logging.md">>]}
    ]},
    {filter_modules, <<"^(webrtc|webrtc_media_codec)$">>},
    %% The pages name internal modules on purpose; webrtc_docs_tests
    %% checks the links between files.
    %% Functions of internal modules that the pages name: add one here
    %% when a page names another.
    {skip_code_autolink_to, [
        <<"webrtc_demux:classify/1">>,
        <<"webrtc_dtls_cert:generate/1">>,
        <<"webrtc_jsep_caps:default_codecs/1">>,
        <<"webrtc_jsep_caps:default_extensions/1">>,
        <<"webrtc_jsep:add_transceiver/3">>,
        <<"webrtc_jsep:negotiated/1">>,
        <<"webrtc_jsep:new/1">>,
        <<"webrtc_rtp:encode/1">>
    ]},
    {skip_undefined_reference_warnings_on, [
        <<"README.md">>,
        <<"docs/CONCEPTS.md">>,
        <<"docs/guides/data-channels.md">>,
        <<"docs/guides/send-media.md">>,
        <<"docs/guides/forward-media.md">>,
        <<"docs/guides/frames-and-codec-plugins.md">>,
        <<"docs/guides/statistics.md">>,
        <<"docs/guides/bandwidth-and-qos.md">>,
        <<"docs/REFERENCE.md">>,
        <<"docs/ARCHITECTURE.md">>,
        <<"docs/DEVELOPER_GUIDE.md">>,
        <<"docs/TESTING.md">>,
        <<"docs/PERFORMANCE.md">>,
        <<"docs/INTEROP.md">>,
        <<"interop/PROTOCOL.md">>,
        <<"docs/COMPLIANCE.md">>,
        <<"docs/compliance/datachannel.md">>,
        <<"docs/compliance/dtls.md">>,
        <<"docs/compliance/ice.md">>,
        <<"docs/compliance/rtp.md">>,
        <<"docs/compliance/sctp.md">>,
        <<"docs/compliance/sdp.md">>,
        <<"docs/compliance/security.md">>,
        <<"docs/compliance/srtp.md">>,
        <<"docs/compliance/stats.md">>,
        <<"docs/compliance/stun.md">>,
        <<"docs/compliance/transport.md">>,
        <<"docs/compliance/turn.md">>,
        <<"docs/adr/0001-dtls-in-erlang.md">>,
        <<"docs/adr/0002-sans-io-engines.md">>,
        <<"docs/adr/0003-transport-per-bundle-group.md">>,
        <<"docs/adr/0004-no-media-coding.md">>,
        <<"docs/adr/0005-per-peer-supervision.md">>,
        <<"docs/adr/0006-redacted-logging.md">>,
        <<"CONTRIBUTING.md">>,
        <<"SECURITY.md">>,
        <<"CHANGELOG.md">>
    ]}
]}.

{hex, [{doc, #{provider => ex_doc}}]}.

{erlfmt, [
    write,
    {files, ["{src,test,include}/**/*.{hrl,erl,app.src}", "rebar.config"]}
]}.

{dialyzer, [
    {warnings, [error_handling, unknown, unmatched_returns]},
    {plt_apps, all_deps},
    {plt_extra_apps, [crypto, public_key, ssl]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    deprecated_function_calls,
    deprecated_functions
]}.

%% eunit only runs the conformance tests at the top of test/; the
%% Common Test suites in test/e2e and test/interop run with rebar3 ct.
{eunit_tests, [{dir, "test"}]}.

{ct_opts, [{sys_config, []}, {logdir, "_build/test/logs"}]}.

{cover_enabled, true}.
