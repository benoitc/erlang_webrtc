{erl_opts, [
    debug_info,
    warn_export_vars,
    warn_shadow_vars,
    warn_obsolete_guard,
    warn_unused_import,
    warnings_as_errors
]}.

{minimum_otp_vsn, "29"}.

%% No runtime dependencies beyond OTP (kernel, stdlib, crypto, public_key).
{deps, []}.

{profiles, [
    {test, [
        {deps, [{proper, "1.4.0"}]},
        {erl_opts, [debug_info, nowarn_export_all, {i, "test/support"}]},
        {extra_src_dirs, [{"test", [{recursive, false}]}, {"test/support", [{recursive, false}]}, {"bench", [{recursive, false}]}]}
    ]}
]}.

{project_plugins, [
    {rebar3_proper, "~> 0.12"},
    {erlfmt, "~> 1.7"},
    {rebar3_hex, "~> 7.0"},
    {rebar3_ex_doc, "~> 0.2"}
]}.

%% API docs (rebar3 ex_doc): the public API is the webrtc module and the
%% webrtc_media_codec behaviour; every other module is internal.
{ex_doc, [
    {source_url, <<"https://github.com/benoitc/erlang_webrtc">>},
    {main, <<"readme">>},
    {extras, [
        <<"README.md">>,
        <<"docs/CONCEPTS.md">>,
        <<"docs/guides/data-channels.md">>,
        <<"docs/guides/send-media.md">>,
        <<"docs/guides/forward-media.md">>,
        <<"docs/guides/frames-and-codec-plugins.md">>,
        <<"docs/guides/statistics.md">>,
        <<"docs/guides/bandwidth-and-qos.md">>,
        <<"docs/REFERENCE.md">>,
        <<"docs/ARCHITECTURE.md">>,
        <<"docs/DEVELOPER_GUIDE.md">>,
        <<"docs/TESTING.md">>,
        <<"docs/PERFORMANCE.md">>,
        <<"docs/INTEROP.md">>,
        <<"interop/PROTOCOL.md">>,
        <<"docs/COMPLIANCE.md">>,
        <<"docs/compliance/datachannel.md">>,
        <<"docs/compliance/dtls.md">>,
        <<"docs/compliance/ice.md">>,
        <<"docs/compliance/rtp.md">>,
        <<"docs/compliance/sctp.md">>,
        <<"docs/compliance/sdp.md">>,
        <<"docs/compliance/security.md">>,
        <<"docs/compliance/srtp.md">>,
        <<"docs/compliance/stats.md">>,
        <<"docs/compliance/stun.md">>,
        <<"docs/compliance/transport.md">>,
        <<"docs/compliance/turn.md">>,
        <<"docs/adr/0001-dtls-in-erlang.md">>,
        <<"docs/adr/0002-sans-io-engines.md">>,
        <<"docs/adr/0003-transport-per-bundle-group.md">>,
        <<"docs/adr/0004-no-media-coding.md">>,
        <<"docs/adr/0005-per-peer-supervision.md">>,
        <<"docs/adr/0006-redacted-logging.md">>,
        <<"CONTRIBUTING.md">>,
        <<"SECURITY.md">>,
        <<"CHANGELOG.md">>,
        <<"LICENSE">>
    ]},
    {groups_for_extras, [
        {<<"Guides">>, [<<"docs/guides/data-channels.md">>, <<"docs/guides/send-media.md">>, <<"docs/guides/forward-media.md">>, <<"docs/guides/frames-and-codec-plugins.md">>, <<"docs/guides/statistics.md">>, <<"docs/guides/bandwidth-and-qos.md">>]},
        {<<"Reference">>, [<<"docs/REFERENCE.md">>, <<"docs/CONCEPTS.md">>]},
        {<<"Change the code">>, [<<"docs/ARCHITECTURE.md">>, <<"docs/DEVELOPER_GUIDE.md">>, <<"docs/TESTING.md">>,
                                 <<"docs/PERFORMANCE.md">>, <<"docs/INTEROP.md">>, <<"interop/PROTOCOL.md">>,
                                 <<"CONTRIBUTING.md">>]},
        {<<"Compliance">>, [<<"docs/COMPLIANCE.md">>, <<"docs/compliance/datachannel.md">>, <<"docs/compliance/dtls.md">>, <<"docs/compliance/ice.md">>, <<"docs/compliance/rtp.md">>, <<"docs/compliance/sctp.md">>, <<"docs/compliance/sdp.md">>, <<"docs/compliance/security.md">>, <<"docs/compliance/srtp.md">>, <<"docs/compliance/stats.md">>, <<"docs/compliance/stun.md">>, <<"docs/compliance/transport.md">>, <<"docs/compliance/turn.md">>]},
        {<<"Design decisions">>, [<<"docs/adr/0001-dtls-in-erlang.md">>, <<"docs/adr/0002-sans-io-engines.md">>, <<"docs/adr/0003-transport-per-bundle-group.md">>, <<"docs/adr/0004-no-media-coding.md">>, <<"docs/adr/0005-per-peer-supervision.md">>, <<"docs/adr/0006-redacted-logging.md">>]}
    ]},
    %% Every module is documented; `webrtc' and the `webrtc_media_codec'
    %% behaviour are the public API, the others may change between
    %% releases (docs/DEVELOPER_GUIDE.md).
    {groups_for_modules, [
        {<<"Public API">>, [webrtc, webrtc_media_codec]},
        {<<"Peer connection">>, [webrtc_stats]},
        {<<"Signaling (JSEP, SDP)">>, [webrtc_jsep, webrtc_jsep_caps, webrtc_sdp, webrtc_sdp_attr, webrtc_sdp_candidate, webrtc_sdp_lex, webrtc_sdp_media, webrtc_sdp_rid, webrtc_sdp_rtp]},
        {<<"Transport">>, [webrtc_demux, webrtc_dscp]},
        {<<"Media session">>, [webrtc_media, webrtc_media_fb, webrtc_media_limit, webrtc_media_report, webrtc_media_rid, webrtc_media_sync]},
        {<<"ICE">>, [webrtc_ice_agent, webrtc_ice_candidate, webrtc_ice_resolve, webrtc_ice_uri]},
        {<<"STUN and TURN">>, [webrtc_stun, webrtc_stun_tx, webrtc_turn_channel, webrtc_turn_client, webrtc_turn_stream]},
        {<<"mDNS">>, [webrtc_mdns, webrtc_mdns_msg, webrtc_mdns_resolver, webrtc_mdns_responder]},
        {<<"DTLS">>, [webrtc_dtls, webrtc_dtls13_keys, webrtc_dtls13_msg, webrtc_dtls13_record, webrtc_dtls_cert, webrtc_dtls_crypto, webrtc_dtls_msg, webrtc_dtls_record]},
        {<<"SRTP">>, [webrtc_srtp, webrtc_srtp_cipher, webrtc_srtp_kdf, webrtc_srtp_profile, webrtc_srtp_replay]},
        {<<"RTP, RTCP and payloads">>, [webrtc_flexfec, webrtc_frame_buffer, webrtc_nack, webrtc_nack_buffer, webrtc_red, webrtc_rtcp, webrtc_rtcp_ccfb, webrtc_rtcp_fb, webrtc_rtcp_interval, webrtc_rtcp_sched, webrtc_rtcp_twcc, webrtc_rtcp_xr, webrtc_rtp, webrtc_rtp_av1, webrtc_rtp_ext, webrtc_rtp_h264, webrtc_rtp_opus, webrtc_rtp_pause, webrtc_rtp_seq, webrtc_rtp_stats, webrtc_rtp_vp8, webrtc_rtp_vp9, webrtc_rtx, webrtc_tmmbr, webrtc_ulpfec]},
        {<<"Congestion control">>, [webrtc_cc, webrtc_cc_probe, webrtc_cc_rate, webrtc_ccfb_receiver, webrtc_circuit_breaker, webrtc_gcc, webrtc_gcc_aimd, webrtc_gcc_delay, webrtc_pacer, webrtc_rate_limit, webrtc_twcc_receiver, webrtc_twcc_sender]},
        {<<"SCTP and data channels">>, [webrtc_dcep, webrtc_sctp_ack, webrtc_sctp_assoc, webrtc_sctp_chunk, webrtc_sctp_cookie, webrtc_sctp_crc32c, webrtc_sctp_handshake, webrtc_sctp_out, webrtc_sctp_param, webrtc_sctp_pmtu, webrtc_sctp_pr, webrtc_sctp_reconfig, webrtc_sctp_recv, webrtc_sctp_send]}
    ]},
    %% The pages name hidden modules on purpose; webrtc_docs_tests
    %% checks the links between files.
    {skip_undefined_reference_warnings_on, [
        <<"README.md">>,
        <<"docs/CONCEPTS.md">>,
        <<"docs/guides/data-channels.md">>,
        <<"docs/guides/send-media.md">>,
        <<"docs/guides/forward-media.md">>,
        <<"docs/guides/frames-and-codec-plugins.md">>,
        <<"docs/guides/statistics.md">>,
        <<"docs/guides/bandwidth-and-qos.md">>,
        <<"docs/REFERENCE.md">>,
        <<"docs/ARCHITECTURE.md">>,
        <<"docs/DEVELOPER_GUIDE.md">>,
        <<"docs/TESTING.md">>,
        <<"docs/PERFORMANCE.md">>,
        <<"docs/INTEROP.md">>,
        <<"interop/PROTOCOL.md">>,
        <<"docs/COMPLIANCE.md">>,
        <<"docs/compliance/datachannel.md">>,
        <<"docs/compliance/dtls.md">>,
        <<"docs/compliance/ice.md">>,
        <<"docs/compliance/rtp.md">>,
        <<"docs/compliance/sctp.md">>,
        <<"docs/compliance/sdp.md">>,
        <<"docs/compliance/security.md">>,
        <<"docs/compliance/srtp.md">>,
        <<"docs/compliance/stats.md">>,
        <<"docs/compliance/stun.md">>,
        <<"docs/compliance/transport.md">>,
        <<"docs/compliance/turn.md">>,
        <<"docs/adr/0001-dtls-in-erlang.md">>,
        <<"docs/adr/0002-sans-io-engines.md">>,
        <<"docs/adr/0003-transport-per-bundle-group.md">>,
        <<"docs/adr/0004-no-media-coding.md">>,
        <<"docs/adr/0005-per-peer-supervision.md">>,
        <<"docs/adr/0006-redacted-logging.md">>,
        <<"CONTRIBUTING.md">>,
        <<"SECURITY.md">>,
        <<"CHANGELOG.md">>
    ]}
]}.

{hex, [
    {doc, ex_doc}
]}.

{erlfmt, [
    write,
    {files, ["{src,test,include}/**/*.{hrl,erl,app.src}", "rebar.config"]}
]}.

{dialyzer, [
    {warnings, [error_handling, unknown, unmatched_returns]},
    {plt_apps, all_deps},
    {plt_extra_apps, [crypto, public_key, ssl]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    deprecated_function_calls,
    deprecated_functions
]}.

%% eunit only runs the conformance tests at the top of test/; the
%% Common Test suites in test/e2e and test/interop run with rebar3 ct.
{eunit_tests, [{dir, "test"}]}.

{ct_opts, [{sys_config, []}, {logdir, "_build/test/logs"}]}.

{cover_enabled, true}.
