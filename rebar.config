{erl_opts, [
    debug_info,
    warn_export_vars,
    warn_shadow_vars,
    warn_obsolete_guard,
    warn_unused_import,
    warnings_as_errors
]}.

{minimum_otp_vsn, "29"}.

%% No runtime dependencies beyond OTP (kernel, stdlib, crypto, public_key).
{deps, []}.

{profiles, [
    {test, [
        {deps, [{proper, "1.4.0"}]},
        {erl_opts, [debug_info, nowarn_export_all, {i, "test/support"}]},
        {extra_src_dirs, [{"test/support", [{recursive, false}]}]}
    ]}
]}.

{project_plugins, [
    {rebar3_proper, "~> 0.12"},
    {erlfmt, "~> 1.7"}
]}.

{erlfmt, [
    write,
    {files, ["{src,test,include}/**/*.{hrl,erl,app.src}", "rebar.config"]}
]}.

{dialyzer, [
    {warnings, [error_handling, unknown, unmatched_returns]},
    {plt_apps, all_deps},
    {plt_extra_apps, [crypto, public_key]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    deprecated_function_calls,
    deprecated_functions
]}.

{ct_opts, [{sys_config, []}, {logdir, "_build/test/logs"}]}.

{cover_enabled, true}.
